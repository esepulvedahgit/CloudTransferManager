APP_ENV=production
APP_BASE_URL=https://cloud-transfer.intranet
HTTP_PORT=8080
HTTPS_PORT=8443
APP_SECRET_KEY_FILE=/run/ctm-secrets/app_secret_key
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cloud_transfer
POSTGRES_USER=cloud_transfer
POSTGRES_PASSWORD_FILE=/run/ctm-secrets/postgres_password
REDIS_URL=redis://redis:6379/0
RCLONE_BINARY=/usr/bin/rclone
MEGACMD_BINARY_DIR=/usr/bin
SMB_ALLOWED_TARGETS=
SMB_INTERACTIVE_TIMEOUT_SECONDS=30
SMB_TRANSFER_MAX_FILES=100000
NEXTCLOUD_MAX_CONCURRENT=1
NEXTCLOUD_BANDWIDTH_LIMIT=8M
NEXTCLOUD_CHUNK_SIZE=10Mi
NEXTCLOUD_JOB_TIMEOUT_SECONDS=43200
TRANSFER_MAX_CONCURRENT=1
TRANSFER_MAX_FILES=5000
TRANSFER_MAX_FILE_BYTES=0
TRANSFER_STAGING_RESERVE_BYTES=1073741824
TRANSFER_STAGING_MARGIN_PERCENT=20
TRANSFER_TEMP_PATH=/var/lib/cloud-transfer/tmp
TRANSFER_STAGING_PATH=/var/lib/cloud-transfer/staging
TRANSFER_MAX_RETRIES=5
# Compose limits are conservative defaults for a single-host installation; tune to host RAM/CPU.
PROXY_CPU_LIMIT=0.50
PROXY_MEMORY_LIMIT=128M
FRONTEND_CPU_LIMIT=0.50
FRONTEND_MEMORY_LIMIT=192M
BACKEND_CPU_LIMIT=1.00
BACKEND_MEMORY_LIMIT=768M
WORKER_CPU_LIMIT=2.00
WORKER_MEMORY_LIMIT=1536M
CONTROL_WORKER_CPU_LIMIT=0.50
CONTROL_WORKER_MEMORY_LIMIT=384M
NOTIFICATION_WORKER_CPU_LIMIT=0.50
NOTIFICATION_WORKER_MEMORY_LIMIT=384M
EVALUATION_WORKER_CPU_LIMIT=1.00
EVALUATION_WORKER_MEMORY_LIMIT=768M
BEAT_CPU_LIMIT=0.50
BEAT_MEMORY_LIMIT=256M
POSTGRES_CPU_LIMIT=1.50
POSTGRES_MEMORY_LIMIT=1536M
REDIS_CPU_LIMIT=0.50
REDIS_MEMORY_LIMIT=384M
REDIS_MAXMEMORY=256mb
# Optional off-site PostgreSQL backup to MEGA S4. Keep disabled until the
# endpoint, bucket, S4 key files, and offline encryption-key copy are ready.
BACKUP_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=cloud-transfer-manager
BACKUP_INTERVAL_SECONDS=600
BACKUP_MAX_AGE_SECONDS=900
BACKUP_CPU_LIMIT=1.00
BACKUP_MEMORY_LIMIT=3G
BACKUP_TMPFS_SIZE=2G
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD_FILE=/run/ctm-secrets/smtp_password
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=28800
